# --- LLM -------------------------------------------------------------------------
# Mozaik picks the provider from the model name. Set the key for the provider you use.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Fast model: payment understanding, price extraction, branching decisions.
INQUEST_MODEL_FAST=claude-haiku-4-5
# Smart model: risk assessment, dossier writing, verification of prose.
INQUEST_MODEL_SMART=claude-sonnet-5-5

# auto    = use the LLM when an API key is present, otherwise deterministic offline fallbacks
# online  = always use the LLM (fails loudly without a key)
# offline = never call the LLM
INQUEST_LLM_MODE=auto
INQUEST_LLM_CONCURRENCY=8
INQUEST_LLM_BUDGET_PER_CASE=12
# Simulated latency of offline "LLM" calls, so that team-vs-single timing stays meaningful without an API key.
INQUEST_OFFLINE_LATENCY_MS=120

# Language of the dossiers written by the LLM (en | sr).
INQUEST_REPORT_LANGUAGE=en

# --- Web search (Price agent market references, company lookups) --------------------
# One of these enables live search. Without either, the agents use the recorded cache only.
TAVILY_API_KEY=
# BRAVE_API_KEY=
# live = search the internet (and record to cache), cache = only replay recorded searches
INQUEST_WEB_MODE=live

# --- Server -----------------------------------------------------------------------------
PORT=8787
