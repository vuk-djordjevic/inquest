# --- LLM -------------------------------------------------------------------------
# Leave the key empty (or set INQUEST_LLM_MODE=offline) to run without an LLM:
# the agents then use deterministic rules and templates, free of charge.
ANTHROPIC_API_KEY=
INQUEST_MODEL_FAST=claude-haiku-4-5
INQUEST_MODEL_SMART=claude-haiku-4-5

# auto    = use the LLM when an API key is present, otherwise offline
# online  = always use the LLM (fails loudly without a key)
# offline = never call the LLM
INQUEST_LLM_MODE=auto
INQUEST_LLM_CONCURRENCY=8
# Max LLM requests per minute (0 = unlimited).
INQUEST_LLM_RPM=40
INQUEST_LLM_BUDGET_PER_CASE=12
# Max LLM calls per run; after that the agents use offline fallbacks (0 = no limit).
# About 2000 covers all real 2021 contracts with Haiku (~$2).
INQUEST_LLM_MAX_CALLS=300
# Simulated latency of offline "LLM" calls, so that team-vs-single timing stays meaningful.
INQUEST_OFFLINE_LATENCY_MS=120

# Language of the dossiers written by the LLM (en | sr).
INQUEST_REPORT_LANGUAGE=en

# --- Web search (market prices for the Price agent) ---------------------------------
# Without a key, the agents replay the recorded search cache only.
TAVILY_API_KEY=
# live = search the internet (and record to cache), cache = only replay recorded searches
INQUEST_WEB_MODE=live

# --- Server -----------------------------------------------------------------------------
PORT=8787
# List real (non-synthetic) cases by name in the dashboard. Off by default: real data is shown in aggregate only.
# INQUEST_SHOW_REAL_CASES=1

# Mozaik cloud (live view of agents): pair once with
#   node node_modules/@mozaik-ai/core/node_modules/@mozaik-ai/cloud-sdk/src/bin.mjs pair
# Prompts, including real data, are then sent to the cloud.
